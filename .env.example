# Supabase project (Project Settings → API). Leave both empty to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the app, used for auth email redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never put the service-role key in this app. It is not needed.
